# --- Agent team ---
# Claude Code worktrees (Desktop session worktrees and subagent worktrees)
.claude/worktrees/
# Team Lead run marker (activates the lead guard hook in that worktree only)
.claude/tlo-active
# Personal settings
.claude/settings.local.json

# Dependencies and test output, wherever an agent leaves them (worktree root included)
node_modules/
test-results/

# --- ShadowChain ---
# SQLite runtime files (WAL mode)
*.db
*.db-wal
*.db-shm
# Frontend dependencies and build output
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
# Compiled binary
/shadowchain
/shadowchain.exe
